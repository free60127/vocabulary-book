# 单词本 · 后端配置（复制为 .env 后填写）
# 本机跑：cp .env.example .env
#
# ⚠️ 本文件里凡是留空的项都是"可选"；只有 AI_API_KEY 不填就跑不起来查词。

# ---------- AI 模型（必填） ----------
# 任何 OpenAI 兼容接口都可以：DeepSeek / OpenAI / 通义 / GLM / Volcano / Ollama ...
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 单次生成允许的最大输出 token（默认 20000；输出被截断时后端会自动用更大上限重试）
AI_MAX_TOKENS=20000

# 本地服务端口（托管平台会自动注入 PORT，不用在这里写）
PORT=8790

# ---------- 词典核对（可选，但强烈建议开着） ----------
# 解决的是"纯 AI 会编"这件事：音标、词性、哪个考试常考，这些**客观事实**交给词典，
# AI 只负责讲解；两者冲突时以词典为准，并在卡片上标出来。
#
#   youdao-web   有道词典网页内部接口，免费、无需 key（默认）
#                ⚠️ 它不是公开 API：无文档、无稳定性承诺、字段随时可能变，也拿不到限流豁免；
#                   属于抓取第三方站点数据，自用可以，**公开/商用请换 youdao-open**。
#   youdao-open  有道智云官方开放平台（https://ai.youdao.com），需 appKey/appSecret，
#                付费但有免费额度。这是唯一合规、稳定的路径。
#   off          关闭，讲解完全由模型生成（词典挂了也会自动降级成这个状态）
# DICT_PROVIDER=youdao-web
# 走官方时的凭据：
# YOUDAO_APP_KEY=xxxxxxxxxxxxxxxx
# YOUDAO_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 词典接口地址。默认 https://dict.youdao.com；自建镜像/代理时改这里（e2e 也用它指向本地 mock）
# DICT_BASE_URL=https://dict.youdao.com

# ---------- 安全（都有安全默认值，按需覆盖） ----------
# 1) 是否允许"匿名访客借用服务端的 Key"。
#    默认允许（自己用最方便）。**站点对公网开放时建议设 0**：否则别人打开你的网址
#    就能白嫖你的额度 —— 这是最容易被忽略、也最烧钱的一条。
# ALLOW_SERVER_KEY=0
# 2) 跨域白名单。默认不发任何 CORS 头（只服务同源页面）。
#    ⚠️ 前端单独部署到 GitHub Pages / Vercel 之后就和后端**不同源**了，必须在这里放行，
#    否则浏览器会拦掉 API 响应（页面看着正常，实际什么都查不出来）。
#    多个来源用英文逗号分隔。
# ALLOW_ORIGIN=https://free60127.github.io
# 3) 客户端提交自定义模型接口（设置面板里的 Base URL）时，默认禁止指向私网/环回地址，
#    防止被当成 SSRF 跳板。本机跑 Ollama 把地址写进上面的 AI_BASE_URL 即可（服务端配置不受限）。
# ALLOW_PRIVATE_BASE_URL=1
# 4) 限流：每个来源 IP 每分钟可提交的模型任务数（默认 30）
# RATE_LIMIT_PER_MIN=30
# 4b) 每日额度（默认 0 = 不限）：用**服务端 Key**的请求每天最多多少次。
#     访客自带 Key 的请求不占额度（花的是他自己的钱）。
#     公网开放 + 用自己的 Key 时**强烈建议设一个**：限流只管"每个 IP 每分钟"，
#     换个 IP 就能接着刷；这个是唯一真正兜住账单的东西。到顶后第二天自动恢复。
# DAILY_JOB_LIMIT=300
# 5) 限流按什么算"一个客户端"——**配错等于限流失效**。
#    X-Forwarded-For 是客户端能自己写的头，只有代理追加在**右端**的那一跳可信；
#    这里配的是"自己前面有几层可信代理"，程序从右往左数。默认：托管平台 1 跳、本机直连 0 跳。
#    当前生效值见 /api/status 的 rateLimit 字段。
# TRUST_PROXY_HOPS=1
# 5b) 可信代理的 socket IP 名单（可选，逗号分隔）。设了它之后，只有 socket 对端确实
#     是名单内的代理时才采信 X-Forwarded-For；否则一律用直连地址。
#     堵的口子：自托管 VPS 配了 TRUST_PROXY_HOPS>=1 但源站可被直连时，
#     攻击者直连并伪造恰好 N 个 XFF 条目即可换头重置限流/登录锁。
#     nginx 本机回源就填 127.0.0.1；Render 等托管平台拿不到代理 IP，不设即可（行为不变）。
# TRUST_PROXY_IPS=127.0.0.1
# 6) 只有**确定流量必经 Cloudflare**（源站不可被直连）时才打开。
# TRUST_CF_CONNECTING_IP=1

# ---------- 多设备同步 + 账号（可选，但公开部署时必须配） ----------
# 这两个功能共用同一套存储，配一次两个都解决。
# 不配置：数据写在服务端本地磁盘 data/ —— 只适合本机 / 自托管 VPS。
#         **托管平台（Render 等）的磁盘是临时的，重新部署或重启就会丢。**
# 配置后：用 Upstash Redis 持久保存（有免费额度，个人用量足够）。
# 申请：https://console.upstash.com → Create Database → 复制 REST URL 与 REST Token
# UPSTASH_REDIS_REST_URL=https://xxxxx-12345.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# ⚠️ 与其它应用**共用同一个 Upstash 库**时必须改 KV_PREFIX（默认 vb:）。
#    账号、云同步、任务、每日额度四块的键都以它打头。姊妹项目「回译本」用的是 bts:，
#    两边默认就是错开的；但如果你把别的应用也接到同一个库，记得让它们各自用不同前缀 ——
#    否则会串库：同一个邮箱在两边互相占位，账号里存的同步码还会让两个应用
#    去读写同一份快照文档（两边结构不同，合并会把对方数据清掉）。
# KV_PREFIX=vb:
#
# ⚠️ 账号功能有个额外的安全默认值：**存储不持久时它直接关闭**。
#    托管平台上开账号却存不住，等于骗用户（重新部署一次所有人的账号就没了），所以宁可不提供。

# ---------- 找回密码的邮件（可选） ----------
# 用你自己的邮箱当 SMTP 发信。**个人免费、零资质**：短信要企业实名，微信/QQ 登录要企业开发者认证，
# 只有这条路个人今天就能走通。
#
# QQ 邮箱：设置 → 账户 → 开启 IMAP/SMTP 服务 → 生成「授权码」（16 位，**不是 QQ 密码**）
# SMTP_USER=3338095791@qq.com
# SMTP_PASS=你的授权码
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_FROM=3338095791@qq.com
# SERVICE_NAME=单词本
#
# 端口不填也行：默认先试 465（隐式 TLS），连不上自动回退 587（STARTTLS）—— 不少云平台拦出站 465。
# 不配置的后果：注册、登录、改密码都正常，只有「忘记密码」发不出邮件。
#
# 密码哈希迭代数（默认 210000）。调高更安全但登录更慢；存量账号不受影响。
# PBKDF2_ITERATIONS=210000
