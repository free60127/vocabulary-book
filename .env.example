# 回译训练工作室 · 后端 AI 配置（复制为 .env 后填写）
# 任何 OpenAI 兼容接口都可以：DeepSeek / OpenAI / 通义 / GLM / Volcano / Ollama ...
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 拍照 / 图片识别（OCR）专用的视觉模型：必须支持图片输入
# DeepSeek 最新的 deepseek-flash 已原生支持图片识别（推荐；DeepSeek 路由下留空也会自动用它）
# 换其他厂商时填对应多模态模型，例如 gpt-4o-mini / qwen-vl-max
AI_VISION_MODEL=deepseek-flash
# 视觉模型也可以用不同的接口 / Key（一般留空，与上面相同即可）
# AI_VISION_BASE_URL=https://api.deepseek.com/v1
# AI_VISION_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 单次生成允许的最大输出 token（默认 20000；输出被截断时后端会自动用更大上限重试）
AI_MAX_TOKENS=20000
# 本地服务端口
PORT=8787
# 任务（批改结果）保留天数 = 「复制分享链接」的有效期。
# 默认 3650 天（10 年，等于长期有效）：一条结果几十 KB，Upstash 免费额度 256MB 够存几千次批改。
# 想控制体积就调小（例：90 = 三个月）。注意：调小之后，超出保留期的老链接就打不开了。
# JOB_TTL_DAYS=3650
# 结果最多保留多少条（默认 2000）：超过就从最旧的开始自动删除。
# 这是防止堆满存储的兜底 —— 免费额度 256MB 是和云同步/账号共用的同一个库，
# 单条结果约 15-60KB，2000 条 ≈ 30-120MB。想更保守就调到 500。
# JOB_MAX_COUNT=2000

# ---------- 安全相关（都有安全默认值，按需覆盖） ----------
# 1) 是否允许"匿名访客借用服务端的 Key"。
#    默认允许（自部署给自己/小范围用最方便）。
#    如果站点对公网开放，建议设 0：强制每个访客填自己的 Key，避免别人白嫖你的额度。
# ALLOW_SERVER_KEY=0
# 2) 跨域白名单。默认不发送任何 CORS 头（只服务同源页面）。
#    ⚠️ 把前端部署到 GitHub Pages 之后，前端就和后端**不同源**了，必须在这里放行。
#    漏配的后果很隐蔽：浏览器会拦掉 API 响应的读取，但**不报错** ——
#    页面看着一切正常，课文列表却悄悄退回了内置的 3 篇示例。
#    （部署工作流里有一条自检就是为了防这个，但真正生效靠的还是这里。）
#    多个来源用英文逗号分隔。
# ALLOW_ORIGIN=https://free60127.github.io
# 3) 客户端提交自定义模型接口（设置面板里的 Base URL）时，
#    默认禁止指向私网/环回地址（127.0.0.1 / 10.x / 192.168.x / 169.254.x …），防止被当成 SSRF 跳板。
#    本机跑 Ollama 这类场景，把地址写在上面 AI_BASE_URL 即可（服务端配置不受此限制）；
#    确实需要放开时再设：
# ALLOW_PRIVATE_BASE_URL=1
# 4) 限流：每个来源 IP 每分钟可提交的模型任务数（默认 30）
# RATE_LIMIT_PER_MIN=30
# 5) 限流按什么算"一个客户端"——**配错等于限流失效**。
#    X-Forwarded-For 是客户端能自己写的头，只有代理追加在**右端**的那一跳才可信；
#    所以这里配的是"自己前面有几层可信代理"，程序从右往左数到那一跳。
#    默认：托管平台（Render / Fly / Vercel / Heroku…）= 1 跳；本机直连 = 0 跳（完全不看该头）。
#    前面挂了两层（例：Cloudflare → Render）就设 2。当前生效值见 /api/status 的 rateLimit 字段。
# TRUST_PROXY_HOPS=1
# 6) 只有**确定流量必经 Cloudflare**（源站不可被直连）时才打开：此时优先用 CF-Connecting-IP。
#    源站能被直连的话，攻击者自己带这个头反而能绕过限流，所以默认关闭。
# TRUST_CF_CONNECTING_IP=1

# ---------- 云同步 + 账号（可选，但强烈建议配） ----------
# 这两个功能共用同一套存储，配一次两个都解决。
# 不配置：数据写在服务端本地磁盘 data/ —— 只适合本机开发 / 自托管 VPS；
#         托管平台（Render 等）的磁盘是临时的，重新部署或重启就会丢。
# 配置后：用 Upstash Redis 持久保存（有免费额度，个人/小团队用量足够；具体额度以官网为准）。
# 申请步骤：https://console.upstash.com → Create Database → 选区域 → 复制 REST URL 与 REST Token
# UPSTASH_REDIS_REST_URL=https://xxxxx-12345.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# ⚠️ 账号功能有个额外的安全默认值：**存储不持久时它直接关闭**。
#    托管平台上开账号却存不住，等于骗用户（重新部署一次所有人的账号就没了），
#    所以宁可不提供。配了上面的 UPSTASH_* 之后自动开启，无需其它开关。

# ---------- 找回密码的邮件（可选） ----------
# 用你自己的邮箱当 SMTP 发信。**个人免费、零资质**：
# 手机短信要企业实名（阿里云已公告不支持个人自用资质），微信/QQ 登录要企业开发者认证，
# 只有这条路是个人今天就能走通的。
#
# QQ 邮箱：设置 → 账户 → 开启 IMAP/SMTP 服务 → 生成「授权码」（16 位，**不是 QQ 密码**）
# SMTP_USER=3338095791@qq.com
# SMTP_PASS=你的授权码
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_FROM=3338095791@qq.com
# SERVICE_NAME=单词本
#
# 端口不填也行：默认先试 465（隐式 TLS），连不上会自动回退到 587（STARTTLS）。
# 不少云平台会拦出站 465，所以两条路都留着。要强制走明文+STARTTLS 就设：
# SMTP_SECURE=0        # 用 587 + STARTTLS
# SMTP_TIMEOUT_MS=20000
#
# 不配置的后果：注册、登录、改密码都正常，只有「忘记密码」发不出邮件。
# 发不出去时会**按原因**给出不同提示（未配置 / 授权码错 / 连不上 / 收件人被拒），
# 不再是一句笼统的"发送失败"—— 这几种的处理方式完全不同。
#
# 注意：QQ 免费邮箱有每日发信量上限，且发出的信容易进垃圾箱（尤其发往非 QQ 邮箱）——
# 所以只用在找回密码这一件事上，别拿它做日常通知。

# 密码哈希迭代数（默认 210000）。调高更安全但登录更慢；
# 存量账号不受影响 —— 验证时用的是每个哈希串里记录的那个迭代数。
# PBKDF2_ITERATIONS=210000
